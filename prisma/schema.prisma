generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 用户信息（从广学账号 SSO 同步；userId 即广学账号用户 ID）
model User {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  userName  String
  admin     Int      @default(0)
  email     String?
  realName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  writingEntries WritingEntry[]
  tagConfigs     TagConfig[]
  notebooks      Notebook[]
}

/// 积累本（一个用户可以有多个，积累条目可以在多个本之间共享）
/// 与广学英语的 Wordbook 同构：用户级命名唯一，条目与本之间是多对多。
model Notebook {
  id        Int             @id @default(autoincrement())
  userId    Int
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user    User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  entries NotebookEntry[]

  @@unique([userId, name])
  @@index([userId])
}

/// 积累本 ↔ 作文积累 多对多关联
model NotebookEntry {
  id             Int      @id @default(autoincrement())
  notebookId     Int
  writingEntryId Int
  createdAt      DateTime @default(now())

  notebook     Notebook     @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  writingEntry WritingEntry @relation(fields: [writingEntryId], references: [id], onDelete: Cascade)

  @@unique([notebookId, writingEntryId])
  @@index([notebookId])
  @@index([writingEntryId])
}

/// 作文积累条目。
/// subject 为学科预留字段：目前只有英语作文（english）；
/// 未来支持语文作文积累时新增 chinese，无需改表结构。
model WritingEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  content   String
  note      String?
  subject   String   @default("english")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [userId], onDelete: Cascade)
  tags      WritingEntryTag[]
  notebooks NotebookEntry[]

  @@index([userId])
  @@index([userId, subject])
}

/// 标签（全局去重，按名称唯一）
model Tag {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  colorId     String   @default("blue")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  writingEntryTags WritingEntryTag[]
}

/// 作文积累 ↔ 标签 多对多关联
model WritingEntryTag {
  id             Int          @id @default(autoincrement())
  writingEntryId Int
  tagId          Int
  createdAt      DateTime     @default(now())

  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  writingEntry WritingEntry @relation(fields: [writingEntryId], references: [id], onDelete: Cascade)

  @@unique([writingEntryId, tagId])
  @@index([tagId])
}

/// 用户级标签配置（颜色、描述）；标签名称与全局 Tag 一一对应
model TagConfig {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  colorId     String   @default("blue")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}
