# 环境变量示例（复制为 .env 并按需修改）

# PostgreSQL 连接串（生产为服务器本机数据库）
DATABASE_URL="postgresql://postgres:password@localhost:5432/gxwtf_writing"

# 广学账号 SSO 地址
GXACCOUNT_URL="https://account.gxwtf.cn"

# iron-session 加密密码（必须 >= 32 字符，生产环境用 openssl rand -base64 32 生成）
SECRET_COOKIE_PASSWORD="please-change-me-to-a-random-32+-chars-string"

# 服务间 API 认证密钥（/api/writing-entries 使用，可选）
SECRET_API_KEY=""

# AI 模型配置（JSON 数组，按顺序降级；「AI 找词」依赖它）
# ⚠️ 必须是**完整合法**的 JSON —— 值被截断（例如只剩 `LLM_CONFIGS='[`）会导致
#    解析失败、模型列表为空，页面上表现为「AI 找词」始终失败，请务必检查引号与括号闭合。
# 可选字段：timeout（毫秒，单次调用超时）、maxRetries（额外重试次数）
# 注意 nginx 默认 proxy_read_timeout 60s，所有调用预算应控制在 60s 以内。
LLM_CONFIGS='[{"name":"primary","model":"your-model-id","apiKey":"sk-xxx","apiBase":"https://your-api-base/v1","timeout":40000,"maxRetries":0}]'
